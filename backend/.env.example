SHOPIFY_SHOP=your-store-name
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Optional. If set, scripts skip client_credentials exchange.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional. Used by test-storefront-products.js.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Backend API
PORT=4000
BACKEND_INTERNAL_SECRET=
POSTGRES_URL=postgres://shopper:shopper@localhost:5433/shopping_agent
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=http://localhost:3000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SHOPIFY_CATALOG_MCP_URL=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_UCP_AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/examples/2026-04-08/valid-with-capabilities.json

# Residential proxy for Google search (required on datacenter IPs to avoid CAPTCHA)
# Format: http://user:pass@host:port  or  socks5://user:pass@host:port
SEARCH_PROXY_URL=
