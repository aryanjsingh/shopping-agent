{
  "name": "shopping-agent-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=backend src/server.ts",
    "start": "tsx --conditions=backend src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "shopify:admin-token": "node scripts/get-admin-token.js",
    "shopify:storefront-token": "node scripts/create-storefront-token.js",
    "shopify:test-storefront": "node scripts/test-storefront-products.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@vercel/blob": "^0.24.1",
    "ai": "6.0.116",
    "bcrypt-ts": "^5.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.34.0",
    "nanoid": "^5.1.3",
    "playwright": "^1.60.0",
    "postgres": "^3.4.4",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
